# Cobalt Observatory Environment Configuration
# Copy to .env and fill in values

# Application
APP_NAME=Cobalt Observatory
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# Server
HOST=0.0.0.0
PORT=8000

# Database (SQLite for development, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./cobalt.db

# Security (CHANGE IN PRODUCTION!)
SECRET_KEY=your-secret-key-here-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM (optional - for evaluation explanations)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Keycloak / OIDC
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=cobalt
KEYCLOAK_CLIENT_ID=cobalt-observatory
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_IN_PRODUCTION

# Observability / OpenTelemetry
OTEL_ENDPOINT=
OTEL_SERVICE_NAME=cobalt-observatory